# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/lockin?retryWrites=true&w=majority"

# Auth.js secret (generate with `openssl rand -base64 32`)
AUTH_SECRET="your-32-byte-base64-or-hex-secret-here-min-32-chars"

# Shared Gemini API Key
GEMINI_API_KEY="AIzaSy..."

# 32-byte encryption key for BYOK storage (64 hex characters or 32 chars)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Gemini model to use (defaults to cheapest flash)
GEMINI_MODEL="gemini-2.0-flash"

# Daily AI call limit for users using shared key
AI_DAILY_CAP_SHARED="10"

# Optional NextAuth URL (usually auto-detected in Vercel/Next.js)
NEXTAUTH_URL="http://localhost:3000"
